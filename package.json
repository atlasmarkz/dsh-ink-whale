{
  "name": "dsh-ink-whale",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 黑白主题：墨色信号场、蓝图标题、毛玻璃输入框与淡蓝 ASCII 鲸群，在「设置 → Ink Whale」中逐项开关（首屏三条、聊天页两条，新建会话页与聊天页各一套参数）。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
